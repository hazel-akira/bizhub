APP_NAME="Akira Bites API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (required for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bizhub
DB_USERNAME=postgres
DB_PASSWORD=
# DB_SSLMODE=require          # Uncomment for managed Postgres with SSL

# SQLite fallback for quick local testing without Postgres
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# For live cashier updates, install Laravel Reverb and set:
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=akira
# REVERB_APP_KEY=akira-key
# REVERB_APP_SECRET=akira-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@akirabites.local"
MAIL_FROM_NAME="${APP_NAME}"

# M-Pesa Daraja (Safaricom) — leave blank for local dev without live STK
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="${APP_URL}/api/payments/stk-callback"

# Comma-separated origins allowed by CORS (web clients only; native Flutter apps bypass CORS)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# Google Sign-In — comma-separated OAuth client IDs (Web, Android, iOS)
# Example: GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-android.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# Sanctum — comma-separated hosts for cookie-based SPA auth (not used by Flutter mobile bearer tokens)
# SANCTUM_STATEFUL_DOMAINS=your-domain.com
# SANCTUM_TOKEN_PREFIX=

# Reverse proxy (Fly.io / nginx) — trust forwarded headers
TRUSTED_PROXIES=*

# Container startup
# RUN_MIGRATIONS=true
# RUN_SEEDER=false

# -----------------------------------------------------------------------------
# Production (Fly.io — see ../../DEPLOY.md)
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://YOUR-APP.fly.dev
# LOG_LEVEL=warning
# MPESA_BASE_URL=https://api.safaricom.co.ke
# MPESA_CALLBACK_URL=https://YOUR-APP.fly.dev/api/mpesa/callback
