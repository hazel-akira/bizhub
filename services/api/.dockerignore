# Git & IDE
.git
.gitignore
.gitattributes
.editorconfig
.idea
.vscode
*.swp
*.swo

# Environment & secrets (injected at runtime by Coolify)
.env
.env.*
!.env.example

# PHP / Composer dev artifacts
vendor
.phpunit.result.cache
phpunit.xml
tests

# Node (not required for API runtime)
node_modules
npm-debug.log
package-lock.json

# Laravel dev / cache (rebuilt in container)
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*
!storage/app/public/.gitignore
bootstrap/cache/*
!bootstrap/cache/.gitignore

# SQLite local database
database/database.sqlite
database/*.sqlite

# Documentation & misc
README.md
COOLIFY_DEPLOYMENT.md
docker.yml

# OS
.DS_Store
Thumbs.db
